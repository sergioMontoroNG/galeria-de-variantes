# Copy to .env and fill in with values from the Partner/Dev Dashboard
# (or from `shopify app env show` once the app is linked).

# App setup > Client credentials in the Dashboard.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Comma-separated, must match `scopes` in shopify.app.toml.
SCOPES=write_products,write_metaobjects,write_metaobject_definitions

# The app's public HTTPS URL. During local dev with `shopify app dev` this is
# filled in automatically (the CLI tunnel URL); set it explicitly for a
# deployed environment, matching application_url in shopify.app.toml.
SHOPIFY_APP_URL=

# Optional: only needed if the app is served behind a custom domain that
# differs from the *.myshopify.com / app URL Shopify expects by default.
SHOP_CUSTOM_DOMAIN=
